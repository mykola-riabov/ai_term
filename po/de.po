#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:4
#: data/pkg/desktop/com.aiterm.Aiterm.desktop.in:4
#: source/gx/aiterm/application.d:321 source/gx/aiterm/appwindow.d:1694
msgid "Aiterm"
msgstr "Aiterm"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:5
#: data/pkg/desktop/com.aiterm.Aiterm.desktop.in:5
msgid "A tiling terminal for GNOME"
msgstr "Ein Terminal für GNOME mit Kacheldarstellung"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:9
msgid "Aiterm is a tiling terminal emulator."
msgstr "Aiterm ist ein Terminal-Emulator mit Kacheldarstellung."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:12
msgid "It lets you:"
msgstr "Damit können Sie:"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:14
msgid ""
"Layout terminals in any fashion by splitting them horizontally or vertically"
msgstr "Terminals durch horizontales oder vertikales Teilen beliebig anordnen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:15
msgid ""
"Terminals can be re-arranged using drag and drop both within and between "
"windows"
msgstr ""
"Terminals durch ziehen und ablegen sowohl innerhalb eines Fensters als auch "
"zwischen Fenstern neu anordnen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:16
msgid "Terminals can be detached into a new window via drag and drop"
msgstr "Terminals per ziehen und ablegen als neues Fenster loslösen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:17
msgid ""
"Input can be synchronized between terminals so commands typed in one "
"terminal are replicated to the others"
msgstr ""
"Die Eingabe zwischen Terminals synchronisieren, um Befehle in einem Terminal "
"auf ein anderes zu replizieren"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:18
msgid "The grouping of terminals can be saved and loaded from disk"
msgstr "Die Gruppierung der Terminals speichern und vom Datenträger laden"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:19
msgid "Terminals support custom titles"
msgstr "Terminals unterstützen benutzerdefinierte Titel"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:20
msgid ""
"Color schemes are stored in files and custom color schemes can be created by "
"simply creating a new file"
msgstr ""
"Farbschemata werden in Dateien gespeichert und benutzerdefinierte "
"Farbschemata können durch Anlegen einer Datei erstellt werden"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:21
msgid "Transparent background"
msgstr "Transparenter Hintergrund"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:22
msgid "Supports notifications when processes are completed out of view"
msgstr ""
"Unterstützt Benachrichtigungen, wenn nicht sichtbare Prozesse beendet werden"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:24
msgid ""
"The application was written using GTK 3 and an effort was made to conform to "
"GNOME Human Interface Guidelines (HIG). As a result, it does use client-side-"
"decorations, though it can be disabled if necessary."
msgstr ""
"Die Anwendung wurde mit GTK 3 geschrieben und es wurde Wert darauf gelegt, "
"den GNOME Human Interface Guidelines (HIG) zu entsprechen. Infolgedessen "
"werden Client Side Decorations verwendet, die aber bei Bedarf deaktiviert "
"werden können."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:28
msgid "Aiterm has been tested with GNOME and with Unity."
msgstr "Aiterm wurde mit GNOME und Unity getestet."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:58
msgid "Aiterm is still looking for a new maintainer!"
msgstr "Aiterm sucht noch immer nach einem neuen Maintainer!"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:59
#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:85
msgid "This release adds the following features:"
msgstr "Diese Version fügt folgende Funktionen hinzu:"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:61
msgid "Disable advanced paste when there is no linebreak like iTerm2"
msgstr ""
"Erweitertes Einfügen deaktivieren, wenn es keinen Zeilenumbruch gibt wie bei "
"iTerm2"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:62
msgid "Add environment variable when in quake mode"
msgstr "Umgebungsvariable im Quake-Modus hinzufügen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:63
msgid "Add possibility to configure always enabled regex"
msgstr ""
"Möglichkeit zum Konfigurieren der immer aktivierten regulären Ausdrücke "
"hinzufügen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:65
#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:91
#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:120
#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:130
msgid "This release fixes the following bugs:"
msgstr "Diese Version behebt die folgenden Fehler:"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:67
msgid "More appdata -&gt; metainfo move"
msgstr "Mehr appdata -&gt; metainfo Verschiebung"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:68
msgid "Add meson target for man page translations"
msgstr "Meson-Ziel für Manpage-Übersetzungen hinzugefügt"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:69
msgid "Update flatpak manifest"
msgstr "Flatpak-Manifest überarbeiten"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:70
msgid "meson: drop unused argument for i18n.merge_file()"
msgstr "meson: unbenutztes Argument für i18n.merge_file() entfernt"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:71
msgid "Stop using deprecated Meson features"
msgstr "Keine Nutzung veralteter Meson-Funktionen mehr"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:72
msgid ""
"Keep quake window open if focus is restored before timeout has been reached"
msgstr ""
"Quake-Fenster offen halten, wenn der Fokus wiederhergestellt wird, bevor die "
"Zeitüberschreitung erreicht ist"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:73
msgid "Don't check GtkDragResult"
msgstr "GtkDragResult nicht prüfen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:74
msgid "Don't add application/x-rootwindow-drop to dragSourceSet targets"
msgstr ""
"Füge application/x-rootwindow-drop nicht zu den dragSourceSet-Zielen hinzu"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:76
msgid "With contributions from:"
msgstr "Mit Beiträgen von:"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:77
msgid ""
"Alan Scherger, Antoine Belvire, David King, Jan Beich, kohnish, luk1337, "
"matishadow, Winston Hoy, Matthias Klumpp"
msgstr ""

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:83
msgid ""
"Aiterm is looking for maintainers! At the moment, only very minimal "
"maintenance is done, no new features will be implemented and pull-requests "
"may be reviewed very slowly."
msgstr ""
"Aiterm sucht nach Maintainern! Im Moment wird es nur minimal gepflegt, es "
"werden keine neuen Funktionen eingebaut und pull-requests können nur sehr "
"langsam bearbeitet werden."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:84
msgid "If you are interested in helping Aiterm, please chime in!"
msgstr "Falls du interessiert bist, Aiterm zu helfen, dann melde dich bitte!"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:87
msgid "Actually install Yaru color scheme"
msgstr "Yaru-Farbschema tatsächlich installieren"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:88
msgid "Give every tab the ${title}"
msgstr "Gib jedem Reiter den Titel ${title}"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:89
msgid "Add option to strip trailing whitespace on paste"
msgstr "Füge Option hinzu, die anhängende Leerzeichen beim einfügen entfernt"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:93
msgid "Fix saving of already saved session"
msgstr "Speichern einer bereits gespeicherten Sitzung behoben"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:94
msgid "Add shortcut to \"Unselect all\""
msgstr "Füge Tastenkombination \"Alles Deselektieren\" hinzu"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:95
msgid "Many Meson buildsystem fixes"
msgstr "Viele Korrekturen am Meson-Buildsystem"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:96
msgid "Avoid missing the previous command exit code when encoding URLs"
msgstr ""
"Vermeide das Übersehen des vorherigen Befehls-Exit-Codes beim Kodieren von "
"URLs"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:97
msgid "Resolve some D deprecation messages"
msgstr "Behebung einiger D Veraltungsmeldungen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:98
msgid "Mention powerline/fonts in README"
msgstr "Erwähnung von Powerline/Schriftarten in README"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:99
msgid "Avoid calling `values()` on a shared object"
msgstr "Vermeide den Aufruf von `values()` auf einem gemeinsamen Objekt"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:100
msgid "Update metainfo data"
msgstr "Metainfo-Daten aktualisiert"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:101
msgid "Drop compat code for older D frontend versions"
msgstr "Entfernen des Kompatibilitätscodes für ältere D-Frontend-Versionen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:102
msgid "Bump minimum VTE version to 0.46"
msgstr "Erhöhung der minimalen VTE-Version auf 0.46"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:103
msgid "Remove deprecated Autotools support"
msgstr "Veraltete Autotools-Unterstützung wurde entfernt"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:104
msgid "Add release notes, NEWS file, automatic metainfo update"
msgstr ""
"Hinzufügen von Versionshinweisen, NEWS-Datei, automatisches Metainfo-Update"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:105
msgid "Update to GtkD 3.9.0"
msgstr "Update auf GtkD 3.9.0"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:107
msgid "This release updates translations."
msgstr "Diese Version aktualisiert die Übersetzungen."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:112
msgid "This release fixes the following bug:"
msgstr "Diese Version korrigiert die Folgenden Fehler:"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:114
msgid ""
"Fixes a problem with the session sidebar getting out of sync after having "
"deleted a session. See issues #1680, #1637 and #1699."
msgstr ""
"Behebt ein Problem, bei dem die Sitzungs-Seitenleiste nach dem Löschen einer "
"Sitzung nicht mehr synchron war. Siehe Probleme #1680, #1637 und #1699."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:122
msgid "Remove app menu for gnome 3.32"
msgstr "App-Menü für Gnome 3.32 entfernen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:123
msgid "Update icon"
msgstr "Icon aktualisiert"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:124
msgid "Minor fixes"
msgstr "Kleinere Korrekturen"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:132
msgid "Small release to update localizations"
msgstr "Kleine Version um die Lokalisation zu aktualisieren"

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:133
msgid "Update to GtkD 3.8.5 to fix library name in GtkD."
msgstr "Update auf GtkD 3.8.5 um den Bibliotheksnamen in GtkD zu korrigieren."

#: data/metainfo/com.aiterm.Aiterm.appdata.xml.rel.in:139
msgid "Some new features and bug fixes."
msgstr "Einige neue Funktionen und Fehler-Korrekturen."

