[Desktop Entry]
Version=1.0
Name=Aiterm
Comment=A tiling terminal for GNOME
Keywords=shell;prompt;command;commandline;cmd;terminal;
Exec=aiterm
Terminal=false
Type=Application
StartupNotify=true
Categories=System;TerminalEmulator;X-GNOME-Utilities;
Icon=com.aiterm.Aiterm
DBusActivatable=true
Actions=new-window;new-session;preferences;

[Desktop Action new-window]
Name=New Window
Exec=aiterm --action=app-new-window

[Desktop Action new-session]
Name=New Session
Exec=aiterm --action=app-new-session

[Desktop Action preferences]
Name=Preferences
Exec=aiterm --preferences
